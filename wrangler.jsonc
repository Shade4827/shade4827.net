{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shade4827-net",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "routes": [
    { "pattern": "shade4827.net", "custom_domain": true },
    { "pattern": "www.shade4827.net", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
